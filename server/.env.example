# Copia este archivo a server/.env (no se sube al repositorio).

# Desarrollo: sin DATABASE_URL se usa una base PostgreSQL embebida en ./data/pglite.
# Producción (Railway): lo inyecta el plugin de PostgreSQL.
# DATABASE_URL=postgresql://usuario:clave@host:5432/devbitacora

# Obligatorio en producción: mínimo 32 caracteres aleatorios.
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Primer editor: se crea al arrancar solo si todavía no hay usuarios.
ADMIN_EMAIL=admin@ejemplo.com
ADMIN_PASSWORD=cambia-esta-clave

# Opcionales
# PORT=3000
# LOGIN_RATE_LIMIT=10
# DATABASE_SSL=true
